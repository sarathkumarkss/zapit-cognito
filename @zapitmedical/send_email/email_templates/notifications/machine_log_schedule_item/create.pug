extends ../../template.pug
block content
  tr
    td Facility
    td Machine
    td Title
    td Category
    td Schedule Item Title
  each t in transactions
    tr
      td= t.machine_log.machine.facility.name
      td= t.machine_log.machine.name
      td= t.title
      td= t.machine_log.category.label
      td= t.schedule_item.title
