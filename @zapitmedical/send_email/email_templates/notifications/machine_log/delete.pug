extends ../../template.pug
block content
  tr
    td Facility
    td Machine
    td Title
    td Category
    td Created By
    td Notes
  each t in transactions
    tr
      td= t.machine.facility.name
      td= t.machine.name
      td= t.title
      td= t.category.label
      td= t.user_deleted.name()
      td
        each n in t.notes
          div #{n.note.content}
